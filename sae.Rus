local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- ==========================================
-- 1. ЭКРАН ЗАГРУЗКИ (LIQUID GLASS)
-- ==========================================
local LoadingGui = Instance.new("ScreenGui")
LoadingGui.Name = "CosmicLoader"
LoadingGui.Parent = CoreGui
LoadingGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 340, 0, 180)
MainFrame.Position = UDim2.new(0.5, -170, 0.5, -90)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 15, 35)
MainFrame.BackgroundTransparency = 0.35
MainFrame.BorderSizePixel = 0
MainFrame.Parent = LoadingGui

local LoaderGradient = Instance.new("UIGradient")
LoaderGradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
    ColorSequenceKeypoint.new(0.4, Color3.fromRGB(30, 20, 50)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 30, 140))
})
LoaderGradient.Rotation = 125
LoaderGradient.Parent = MainFrame

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 18)
UICorner.Parent = MainFrame

local UIStroke = Instance.new("UIStroke")
UIStroke.Color = Color3.fromRGB(200, 170, 255)
UIStroke.Transparency = 0.4
UIStroke.Thickness = 1.5
UIStroke.Parent = MainFrame

local TitleLabel = Instance.new("TextLabel")
TitleLabel.Size = UDim2.new(1, 0, 0, 40)
TitleLabel.Position = UDim2.new(0, 0, 0, 20)
TitleLabel.BackgroundTransparency = 1
TitleLabel.Text = "COSMIC HUB V5 🚀"
TitleLabel.TextColor3 = Color3.fromRGB(220, 180, 255)
TitleLabel.TextSize = 22
TitleLabel.Font = Enum.Font.FredokaOne
TitleLabel.Parent = MainFrame

local UserLabel = Instance.new("TextLabel")
UserLabel.Size = UDim2.new(1, 0, 0, 30)
UserLabel.Position = UDim2.new(0, 0, 0, 60)
UserLabel.BackgroundTransparency = 1
UserLabel.Text = "Welcome, Bashenei (Амир)"
UserLabel.TextColor3 = Color3.fromRGB(240, 240, 255)
UserLabel.TextSize = 16
UserLabel.Font = Enum.Font.FredokaOne
UserLabel.Parent = MainFrame

local StatusLabel = Instance.new("TextLabel")
StatusLabel.Size = UDim2.new(1, 0, 0, 20)
StatusLabel.Position = UDim2.new(0, 0, 0, 100)
StatusLabel.BackgroundTransparency = 1
StatusLabel.Text = "Applying Liquid Glass Style..."
StatusLabel.TextColor3 = Color3.fromRGB(180, 170, 210)
StatusLabel.TextSize = 13
StatusLabel.Font = Enum.Font.SourceSansItalic
StatusLabel.Parent = MainFrame

task.wait(2)

local FadeTween = TweenService:Create(MainFrame, TweenInfo.new(0.5), {BackgroundTransparency = 1})
TweenService:Create(UIStroke, TweenInfo.new(0.5), {Transparency = 1}):Play()
TweenService:Create(TitleLabel, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
TweenService:Create(UserLabel, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
TweenService:Create(StatusLabel, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
FadeTween:Play()
FadeTween.Completed:Wait()
LoadingGui:Destroy()

-- ==========================================
-- 2. ОСНОВНОЙ ИНТЕРФЕЙС (FLUENT GLASS)
-- ==========================================
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "Cosmic Hub V5 | Liquid Glass 🌌",
    SubTitle = "Bashenei (Амир)",
    TabWidth = 160,
    Size = UDim2.fromOffset(540, 380),
    Acrylic = false,
    Theme = "Amethyst",
    MinimizeKey = Enum.KeyCode.LeftControl
})

-- КАСТОМИЗАЦИЯ ПОД LIQUID GLASS
local function applyGlassStyle(guiObject)
    if not guiObject then return end
    pcall(function()
        guiObject.BackgroundTransparency = 0.35
        guiObject.BackgroundColor3 = Color3.fromRGB(20, 15, 35)

        local GlassGradient = Instance.new("UIGradient")
        GlassGradient.Name = "LiquidGlassGradient"
        GlassGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(35, 25, 55)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(15, 10, 25)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(75, 25, 110))
        })
        GlassGradient.Rotation = 135
        GlassGradient.Parent = guiObject

        local GlassStroke = guiObject:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
        GlassStroke.Color = Color3.fromRGB(220, 180, 255)
        GlassStroke.Transparency = 0.5
        GlassStroke.Thickness = 1.2
        GlassStroke.Parent = guiObject
    end)
end

applyGlassStyle(Window.Root)

-- ==========================================
-- 3. ПЛАВАЮЩАЯ СТЕКЛЯННАЯ КНОПКА
-- ==========================================
local ToggleGui = Instance.new("ScreenGui")
ToggleGui.Name = "CosmicToggleGui"
ToggleGui.Parent = CoreGui
ToggleGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local ToggleButton = Instance.new("TextButton")
ToggleButton.Name = "ToggleButton"
ToggleButton.Size = UDim2.new(0, 52, 0, 52)
ToggleButton.Position = UDim2.new(0.05, 0, 0.2, 0)
ToggleButton.BackgroundColor3 = Color3.fromRGB(25, 18, 40)
ToggleButton.BackgroundTransparency = 0.25
ToggleButton.Text = "🚀"
ToggleButton.TextSize = 24
ToggleButton.Parent = ToggleGui

local BtnGradient = Instance.new("UIGradient")
BtnGradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 130, 255)),
    ColorSequenceKeypoint.new(0.3, Color3.fromRGB(30, 20, 50)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(110, 40, 160))
})
BtnGradient.Rotation = 135
BtnGradient.Parent = ToggleButton

local BtnCorner = Instance.new("UICorner")
BtnCorner.CornerRadius = UDim.new(1, 0)
BtnCorner.Parent = ToggleButton

local BtnStroke = Instance.new("UIStroke")
BtnStroke.Color = Color3.fromRGB(230, 200, 255)
BtnStroke.Transparency = 0.3
BtnStroke.Thickness = 1.8
BtnStroke.Parent = ToggleButton

local dragging, dragInput, dragStart, startPos

local function update(input)
    local delta = input.Position - dragStart
    ToggleButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

ToggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = ToggleButton.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

ToggleButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

ToggleButton.MouseButton1Click:Connect(function()
    Window:Minimize()
end)

-- ==========================================
-- 4. ВКЛАДКИ И ФУНКЦИОНАЛ
-- ==========================================
local Tabs = {
    Main = Window:AddTab({ Title = "Farm & Steal", Icon = "sparkles" }),
    Visuals = Window:AddTab({ Title = "ESP & Visuals", Icon = "eye" }),
    Player = Window:AddTab({ Title = "Player", Icon = "user" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

local Options = Fluent.Options

local function getHRP()
    return LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
end

-- Вкладка Main
do
    Tabs.Main:AddToggle("AutoSteal", {Title = "Auto Steal Eggs (Touch)", Default = false})
    Tabs.Main:AddToggle("AutoCollectPrompts", {Title = "Auto Collect (ProximityPrompt)", Default = false})
    Tabs.Main:AddToggle("AutoDeposit", {Title = "Auto Deposit Eggs", Default = false})

    task.spawn(function()
        while task.wait(0.1) do
            if Options.AutoSteal.Value then
                pcall(function()
                    local hrp = getHRP()
                    if hrp then
                        for _, obj in pairs(Workspace:GetDescendants()) do
                            if obj:IsA("TouchTransmitter") and obj.Parent then
                                local name = obj.Parent.Name:lower()
                                if name:find("egg") or name:find("yolk") or name:find("collect") then
                                    firetouchinterest(hrp, obj.Parent, 0)
                                    task.wait()
                                    firetouchinterest(hrp, obj.Parent, 1)
                                end
                            end
                        end
                    end
                end)
            end
        end
    end)

    task.spawn(function()
        while task.wait(0.2) do
            if Options.AutoCollectPrompts.Value then
                pcall(function()
                    for _, prompt in pairs(Workspace:GetDescendants()) do
                        if prompt:IsA("ProximityPrompt") then
                            fireproximityprompt(prompt)
                        end
                    end
                end)
            end
        end
    end)

    task.spawn(function()
        while task.wait(0.3) do
            if Options.AutoDeposit.Value then
                pcall(function()
                    local hrp = getHRP()
                    if hrp then
                        for _, obj in pairs(Workspace:GetDescendants()) do
                            if obj:IsA("TouchTransmitter") and obj.Parent then
                                local name = obj.Parent.Name:lower()
                                if name:find("deposit") or name:find("base") or name:find("sell") or name:find("drop") then
                                    firetouchinterest(hrp, obj.Parent, 0)
                                    task.wait()
                                    firetouchinterest(hrp, obj.Parent, 1)
                                end
                            end
                        end
                    end
                end)
            end
        end
    end)
end

-- Вкладка Visuals
do
    Tabs.Visuals:AddToggle("EggESP", {Title = "ESP Eggs", Default = false})
    Tabs.Visuals:AddToggle("PlayerESP", {Title = "ESP Players", Default = false})

    local highlights = {}

    local function clearESP()
        for _, h in pairs(highlights) do
            if h then h:Destroy() end
        end
        highlights = {}
    end

    task.spawn(function()
        while task.wait(1) do
            if Options.EggESP.Value or Options.PlayerESP.Value then
                clearESP()
                pcall(function()
                    if Options.EggESP.Value then
                        for _, v in pairs(Workspace:GetDescendants()) do
                            if (v:IsA("BasePart") or v:IsA("Model")) and v.Name:lower():find("egg") then
                                local hl = Instance.new("Highlight")
                                hl.FillColor = Color3.fromRGB(255, 215, 0)
                                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                hl.Parent = v
                                table.insert(highlights, hl)
                            end
                        end
                    end

                    if Options.PlayerESP.Value then
                        for _, p in pairs(Players:GetPlayers()) do
                            if p ~= LocalPlayer and p.Character then
                                local hl = Instance.new("Highlight")
                                hl.FillColor = Color3.fromRGB(160, 80, 255)
                                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                hl.Parent = p.Character
                                table.insert(highlights, hl)
                            end
                        end
                    end
                end)
            else
                clearESP()
            end
        end
    end)
end

-- Вкладка Player
do
    Tabs.Player:AddSlider("WalkSpeed", {Title = "WalkSpeed", Default = 16, Min = 16, Max = 250, Rounding = 0})
    Tabs.Player:AddSlider("JumpPower", {Title = "JumpPower", Default = 50, Min = 50, Max = 300, Rounding = 0})
    Tabs.Player:AddToggle("Noclip", {Title = "Noclip", Default = false})
    Tabs.Player:AddToggle("InfJump", {Title = "Infinite Jump", Default = false})

    RunService.RenderStepped:Connect(function()
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.WalkSpeed = Options.WalkSpeed.Value
                LocalPlayer.Character.Humanoid.JumpPower = Options.JumpPower.Value
            end

            if Options.Noclip.Value and LocalPlayer.Character then
                for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end)

    UserInputService.JumpRequest:Connect(function()
        if Options.InfJump.Value and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
end

-- Вкладка Settings
do
    local SizeSlider = Tabs.Settings:AddSlider("GUISizeWidth", {
        Title = "Ширина GUI (Width)",
        Default = 540,
        Min = 350,
        Max = 800,
        Rounding = 0
    })

    local HeightSlider = Tabs.Settings:AddSlider("GUISizeHeight", {
        Title = "Высота GUI (Height)",
        Default = 380,
        Min = 260,
        Max = 600,
        Rounding = 0
    })

    SizeSlider:OnChanged(function(value)
        pcall(function()
            Window.Root.Size = UDim2.fromOffset(value, Options.GUISizeHeight.Value)
        end)
    end)

    HeightSlider:OnChanged(function(value)
        pcall(function()
            Window.Root.Size = UDim2.fromOffset(Options.GUISizeWidth.Value, value)
        end)
    end)
end

Window:SelectTab(1)

Fluent:Notify({
    Title = "Cosmic Hub V5",
    Content = "Стеклянный Liquid Glass дизайн применён для Амира!",
    Duration = 5
})
