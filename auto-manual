local function stopAutoRun(reason)
    AutoRunning=false
    stopSpeedForce()   -- always restore original walk speed on stop
    log("AutoRun: STOPPED — "..(reason or "done"),LOG_WARN)
    if AutoRunEnabled then
        setArVisual("on","ON  •  waiting for egg pickup")
    else
        setArVisual("off","OFF")
    end
end

local function startAutoRun()
    if AutoRunning then log("AutoRun: already running, skip",LOG_WARN); return end
    AutoRunning=true
    log("AutoRun: START — MOVING TO BASE (speed="..RUN_SPEED..")",LOG_OK)
    setArVisual("running","Running to base...")

    task.spawn(function()
        local target = getBasePosition()
        log(string.format("AutoRun: base = %.1f, %.1f, %.1f", target.X, target.Y, target.Z), LOG_INFO)

        local char = Player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        if not char or not root or not hum then
            log("AutoRun: missing character/root/humanoid", LOG_ERR)
            stopAutoRun("no character"); return
        end

        -- ══════════════════════════════════════════════════════════════
        -- TRY TO PICK UP EGG (if CollectEvent remote is available)
        -- This makes big eggs carriable by calling the remote
        -- ══════════════════════════════════════════════════════════════
        if CollectEvent and CurrentEggUid then
            log("AutoRun: attempting to carry egg '"..CurrentEggUid.."'", LOG_INFO)
            pcall(function()
                CollectEvent:InvokeServer(CurrentEggUid)
                log("AutoRun: egg carry remote invoked", LOG_OK)
            end)
            task.wait(0.2)  -- brief pause for egg to attach
        end

        -- Start a Heartbeat to force WalkSpeed every frame
        local speedConn = RunService.Heartbeat:Connect(function()
            if not AutoRunning then return end
            local c = Player.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if h then
                pcall(function() h.WalkSpeed = RUN_SPEED end)
            end
        end)

        local startTime = tick()
        local TIMEOUT = 30  -- 30 seconds to get home
        
        while AutoRunning and AutoRunEnabled do
            local c = Player.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            local r = c and c:FindFirstChild("HumanoidRootPart")
            
            if not h or not r then
                speedConn:Disconnect()
                log("AutoRun: lost humanoid/root", LOG_ERR)
                stopAutoRun("lost root"); return
            end
            
            if h.Health <= 0 then
                speedConn:Disconnect()
                log("AutoRun: died", LOG_ERR)
                stopAutoRun("dead"); return
            end
            
            local dist = (r.Position - target).Magnitude
            
            if dist <= ARRIVE_DIST then
                speedConn:Disconnect()
                log("AutoRun: ARRIVED at base!", LOG_OK)
                break
            end
            
            if tick() - startTime > TIMEOUT then
                speedConn:Disconnect()
                log("AutoRun: timeout after "..math.floor(tick()-startTime).."s", LOG_WARN)
                stopAutoRun("timeout"); return
            end
            
            pcall(function() h:MoveTo(target) end)
            task.wait(0.1)
        end
        
        stopAutoRun("done")
    end)
end

