-- Heartbeat that forces WalkSpeed every frame while running.
-- This counters any server script that resets WalkSpeed each frame.
local _speedConn = nil

local function startSpeedForce()
    if _speedConn then _speedConn:Disconnect(); _speedConn = nil end
    _speedConn = RunService.Heartbeat:Connect(function()
        if not AutoRunning then
            _speedConn:Disconnect(); _speedConn = nil; return
        end
        local char = Player.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            pcall(function() hum.WalkSpeed = RUN_SPEED end)
        end
    end)
end

local function stopSpeedForce()
    if _speedConn then _speedConn:Disconnect(); _speedConn = nil end
    -- restore the player's original walk speed
    local char = Player.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum.WalkSpeed = _originalWalkSpeed end) end
end

local function getBasePosition()
    -- 1. RespawnLocation on the player
    local rl = Player.RespawnLocation
    if rl then
        log("Base: found RespawnLocation '"..rl.Name.."' at "..tostring(rl.Position),LOG_INFO)
        return rl.Position
    end
    log("Base: RespawnLocation is nil, scanning workspace...",LOG_WARN)

    -- 2. Scan workspace for SpawnLocation
    local found=nil
    pcall(function()
        for _,obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("SpawnLocation") then
                log("Base: found SpawnLocation '"..obj.Name.."' at "..tostring(obj.Position),LOG_INFO)
                found=obj.Position; break
            end
        end
    end)
    if found then return found end

    -- 3. Hardcoded fallback
    log("Base: no SpawnLocation found, using FALLBACK "..tostring(FALLBACK_BASE),LOG_WARN)
    return FALLBACK_BASE
end

