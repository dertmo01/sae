    TextBlock.LayoutOrder = 3
    TextBlock.Parent = ContentContainer

    local TextList = Instance.new("UIListLayout")
    TextList.FillDirection = Enum.FillDirection.Vertical
    TextList.HorizontalAlignment = Enum.HorizontalAlignment.Center
    TextList.VerticalAlignment = Enum.VerticalAlignment.Top
    TextList.Padding = UDim.new(0, 10)
    TextList.Parent = TextBlock

    local StatusLabel = Instance.new("TextLabel")
    StatusLabel.Name = "StatusLabel"
    StatusLabel.Size = UDim2.new(1, 0, 0, 14)
    StatusLabel.BackgroundTransparency = 1
    StatusLabel.Text = "Bypassing Script..."
    StatusLabel.TextColor3 = Color3.fromRGB(85, 115, 175)
    StatusLabel.TextSize = 11
    StatusLabel.Font = Enum.Font.Code
    StatusLabel.TextXAlignment = Enum.TextXAlignment.Center
    StatusLabel.Parent = TextBlock

    local SubtextLabel = Instance.new("TextLabel")
    SubtextLabel.Name = "SubtextLabel"
    SubtextLabel.Size = UDim2.new(1, 0, 0, 12)
    SubtextLabel.BackgroundTransparency = 1
    SubtextLabel.Text = "First load may take longer than usual."
    SubtextLabel.TextColor3 = Color3.fromRGB(50, 65, 100)
    SubtextLabel.TextSize = 10
    SubtextLabel.Font = Enum.Font.Gotham
    SubtextLabel.TextXAlignment = Enum.TextXAlignment.Center
    SubtextLabel.Parent = TextBlock

    -- Flicker
    local isFlickering = true
    task.spawn(function()
        while StatusLabel.Parent do
            if isFlickering then
                TweenService:Create(StatusLabel, TweenInfo.new(0.4, Enum.EasingStyle.Sine), {TextTransparency = 0.7}):Play()
                task.wait(0.4)
                TweenService:Create(StatusLabel, TweenInfo.new(0.4, Enum.EasingStyle.Sine), {TextTransparency = 0}):Play()
                task.wait(0.4)
            else
                StatusLabel.TextTransparency = 0
                task.wait(0.1)
            end
        end
    end)

    -- Smooth percent
    local displayedPercent = 0
    local renderConnection

    renderConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if ProgressFill and ProgressFill.Parent then
            local targetPercent = math.clamp(ProgressFill.Size.X.Scale * 100, 0, 100)
            displayedPercent = displayedPercent + (targetPercent - displayedPercent) * math.clamp(deltaTime * 10, 0, 1)
            PercentageLabel.Text = string.format("%.1f%%", displayedPercent)
        else
            renderConnection:Disconnect()
        end
    end)

    -- Loader Sequence
    local function startLoaderSequence()
        StatusLabel.Text = "Bypassing Script..."
        isFlickering = true
        
        local tweenTo95 = TweenService:Create(ProgressFill, TweenInfo.new(90, Enum.EasingStyle.Linear), {
            Size = UDim2.new(0.95, 0, 1, 0)
        })
        tweenTo95:Play()
        tweenTo95.Completed:Wait()

        StatusLabel.Text = "awaiting controller attach..."
        isFlickering = true
        task.wait(20)

        isFlickering = false
        StatusLabel.Text = "finalizing script execution..."
        StatusLabel.TextTransparency = 0
        
        local tweenTo100 = TweenService:Create(ProgressFill, TweenInfo.new(10, Enum.EasingStyle.Linear), {
            Size = UDim2.new(1, 0, 1, 0)
        })
        tweenTo100:Play()
        tweenTo100.Completed:Wait()

        StatusLabel.Text = "successfully loaded!"
        StatusLabel.TextColor3 = Color3.fromRGB(70, 180, 120)
        
        task.wait(0.6)
        if renderConnection then renderConnection:Disconnect() end

        for _, desc in ipairs(LoaderMain:GetDescendants()) do
            if desc:IsA("TextLabel") then TweenService:Create(desc, TweenInfo.new(0.4), {TextTransparency = 1}):Play() end
            if desc:IsA("Frame") then TweenService:Create(desc, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play() end
            if desc:IsA("UIStroke") then TweenService:Create(desc, TweenInfo.new(0.4), {Transparency = 1}):Play() end
        end
        TweenService:Create(LoaderMain, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()

        task.wait(0.4)
        LoaderScreenGui:Destroy()
    end

    task.spawn(startLoaderSequence)
end

-- =====================================================
-- KEY SYSTEM ANIMATIONS + EVENTS
-- =====================================================
local isAnimating = false

local function triggerErrorAnimation()
    if isAnimating then return end
    isAnimating = true

    TweenService:Create(InputBox, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(60, 20, 25) }):Play()
    TweenService:Create(InputStroke, TweenInfo.new(0.15), { Color = Color3.fromRGB(240, 80, 80) }):Play()

    task.spawn(function()
        local mainOffsets = {7, -7, 5, -5, 3, -3, 0}
        local tweenInfo = TweenInfo.new(0.04, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        
        for _, xOffset in ipairs(mainOffsets) do
            local tween = TweenService:Create(MainFrame, tweenInfo, { Position = NORMAL_MAIN_POS + UDim2.new(0, xOffset, 0, 0) })
            tween:Play()
            tween.Completed:Wait()
        end
    end)

    task.spawn(function()
        local inputOffsets = {-6, 6, -4, 4, -2, 2, 0}
        local tweenInfo = TweenInfo.new(0.04, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        
        for _, yOffset in ipairs(inputOffsets) do
            local tween = TweenService:Create(InputBox, tweenInfo, { Position = NORMAL_INPUT_POS + UDim2.new(0, 0, 0, yOffset) })
            tween:Play()
            tween.Completed:Wait()
        end
    end)

    task.delay(0.4, function()
        TweenService:Create(InputBox, TweenInfo.new(0.3), { BackgroundColor3 = NORMAL_INPUT_BG }):Play()
        TweenService:Create(InputStroke, TweenInfo.new(0.3), { Color = NORMAL_INPUT_STROKE }):Play()
        task.wait(0.3)
        isAnimating = false
    end)
end

local function triggerSuccessUnlock()
    ContinueBtn.Text = "Unlocked!"
    TweenService:Create(ContinueBtn, TweenInfo.new(0.3), { BackgroundColor3 = Color3.fromRGB(45, 190, 100) }):Play()
    
    TweenService:Create(MainStroke, TweenInfo.new(0.3), { Color = Color3.fromRGB(72, 230, 138), Transparency = 0 }):Play()
    TweenService:Create(InputStroke, TweenInfo.new(0.3), { Color = Color3.fromRGB(72, 230, 138) }):Play()

    ShineOverlay.Position = UDim2.new(-0.3, 0, 0, 0)
    TweenService:Create(ShineOverlay, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { Position = UDim2.new(1.3, 0, 0, 0) }):Play()

    TweenService:Create(Blur, TweenInfo.new(0.6, Enum.EasingStyle.Sine), { Size = 0 }):Play()

    task.wait(0.4)

    local exitInfo = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    
    TweenService:Create(MainFrame, exitInfo, {
        Size = UDim2.new(0, 410, 0, 220),
        Position = UDim2.new(0.5, -205, 0.5, -110)
    }):Play()

    for _, desc in ipairs(MainFrame:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("TextBox") or desc:IsA("TextButton") then
            TweenService:Create(desc, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
        end
        if desc:IsA("Frame") or desc:IsA("TextBox") or desc:IsA("TextButton") then
            TweenService:Create(desc, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
        end
        if desc:IsA("UIStroke") then
            TweenService:Create(desc, TweenInfo.new(0.3), { Transparency = 1 }):Play()
        end
    end
    TweenService:Create(MainFrame, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()

    task.wait(0.4)
    Blur:Destroy()
    KeyScreenGui:Destroy()
    
    print("Key system successfully unlocked!")
    
    -- >>> START LOADING UI AFTER KEY SYSTEM DISAPPEARS <<<
    startLoadingUI()
end

-- Events
GetKeyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(GET_KEY_LINK)
    end
    
    SuccessLabel.Text = "Key link copied"
    
    task.delay(5, function()
        if SuccessLabel.Text == "Key link copied" then
            SuccessLabel.Text = ""
        end
    end)
end)

ContinueBtn.MouseButton1Click:Connect(function()
    if isAnimating then return end
    local userText = InputBox.Text
    ErrorLabel.Text = ""
    
    if userText == "" then
        ErrorLabel.Text = "Enter your key."
        triggerErrorAnimation()
        
        task.delay(5, function()
            if ErrorLabel.Text == "Enter your key." then
                ErrorLabel.Text = ""
            end
        end)
        
    elseif userText == CORRECT_KEY then
        ErrorLabel.Text = ""
        triggerSuccessUnlock()
    else
        ErrorLabel.Text = "Invalid key."
        triggerErrorAnimation()
        
        task.delay(5, function()
            if ErrorLabel.Text == "Invalid key." then
                ErrorLabel.Text = ""
            end
        end)
    end
end)
