-- Main loop
task.spawn(function()
    local lastTread = 0
    while GEN == _G.__EggStealGen do
        status.Text = "Status: " .. (AUTO and "ON" or "OFF") .. "  |  " .. LAST

        if AUTO and not BUSY then
            if isNight() then
                -- Night → treadmill or sakura
                if isGreatBloomActive() then
                    farmSakuraCrystals(12)
                else
                    farmTreadmill(5)
                end
            else
                -- Day → Steal first, then sakura, then treadmill
                local stole = stealOnce()
                if not stole then
                    if isGreatBloomActive() then
                        farmSakuraCrystals(14)
                    else
                        if os.clock() - lastTread > 3 then
                            farmTreadmill(3.5)
                            lastTread = os.clock()
                        end
                    end
                end
            end
        end
        task.wait(0.4)
    end
end)

