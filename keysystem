-- FLICKER ANIMATION (Permanenteng naka-stay sa "Bypassing Script...")
local isFlickering = true
task.spawn(function()
    while StatusLabel.Parent do
        if isFlickering then
            TweenService:Create(StatusLabel, TweenInfo.new(0.4, Enum.EasingStyle.Sine), {TextTransparency = 0.7}):Play()
            task.wait(0.4)
            TweenService:Create(StatusLabel, TweenInfo.new(0.4, Enum.EasingStyle.Sine), {TextTransparency = 0}):Play()
            task.wait(0.4)
        else
            StatusLabel.TextTransparency = 0
            task.wait(0.1)
        end
    end
end)

-- SMOOTH PERCENTAGE COUNTER
local displayedPercent = 0
local renderConnection

renderConnection = RunService.RenderStepped:Connect(function(deltaTime)
    if ProgressFill and ProgressFill.Parent then
        local targetPercent = math.clamp(ProgressFill.Size.X.Scale * 100, 0, 100)
        displayedPercent = displayedPercent + (targetPercent - displayedPercent) * math.clamp(deltaTime * 10, 0, 1)
        PercentageLabel.Text = string.format("%.1f%%", displayedPercent)
    else
        renderConnection:Disconnect()
    end
end)

-- 3-MINUTE LOADER SEQUENCE
local function startLoaderSequence()
    StatusLabel.Text = "Bypassing Script..."
    isFlickering = true
    
    -- Part 1: Continuous movement mula 0% hanggang 80% sa loob ng 90 seconds (1.5 minutes)
    local tweenTo80 = TweenService:Create(ProgressFill, TweenInfo.new(90, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0.80, 0, 1, 0)
    })
    tweenTo80:Play()
    tweenTo80.Completed:Wait()

    -- Part 2: Pabagal nang pabagal mula 80% hanggang 95% sa loob ng 90 seconds (1.5 minutes)
    local tweenTo95 = TweenService:Create(ProgressFill, TweenInfo.new(90, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
        Size = UDim2.new(0.95, 0, 1, 0)
    })
    tweenTo95:Play()
    tweenTo95.Completed:Wait()

    -- SAKTO 3 MINUTES TOTAL (90s + 90s = 180s):
    -- Dito na magso-stop at mananatiling naka-stuck sa 95% ang UI habang naka-display pa rin ang "Bypassing Script..."
end

task.spawn(startLoaderSequence)
