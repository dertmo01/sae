--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function getCharacterRoot()

    local character =
        LocalPlayer.Character

    if not character then
        return nil
    end

    return character:FindFirstChild(
        "HumanoidRootPart"
    )
end

local function getPosition(instance)

    if instance:IsA("BasePart") then
        return instance.Position
    end

    if instance:IsA("Model") then

        if instance.PrimaryPart then
            return instance.PrimaryPart.Position
        end

        local part =
            instance:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

        if part then
            return part.Position
        end
    end

    return nil
end

local function getDistance(instance)

    local root =
        getCharacterRoot()

    local position =
        getPosition(instance)

    if not root or not position then
        return math.huge
    end

    return (
        root.Position - position
    ).Magnitude
end

local function isEggName(name)

    local lower =
        string.lower(name)

    for _, keyword in ipairs(
        EGG_KEYWORDS
    ) do

        if string.find(
            lower,
            keyword,
            1,
            true
        ) then
            return true
        end

    end

    return false
end

local function formatValue(value)

    local valueType =
        typeof(value)

    if valueType == "Vector3" then

        return string.format(
            "(%.2f, %.2f, %.2f)",
            value.X,
            value.Y,
            value.Z
        )

    elseif valueType == "CFrame" then

        local p =
            value.Position

        return string.format(
            "CFrame(%.2f, %.2f, %.2f)",
            p.X,
            p.Y,
            p.Z
        )

    elseif valueType == "Color3" then

        return string.format(
            "RGB(%.2f, %.2f, %.2f)",
            value.R,
            value.G,
            value.B
        )

    end

    return tostring(value)
end

--------------------------------------------------
-- EGG RESULTS
--------------------------------------------------

local eggResults = {}

local function scanEggs()

    eggResults = {}

    local root =
        getCharacterRoot()

    if not root then

        status.Text =
            "Character root unavailable"

        return
    end

    for _, instance in ipairs(
        workspace:GetDescendants()
    ) do

        if isEggName(instance.Name) then

            local distance =
                getDistance(instance)

            if distance <= SCAN_RADIUS then

                table.insert(
                    eggResults,
                    {
                        instance = instance,
                        distance = distance
                    }
                )

            end
        end
    end

    table.sort(
        eggResults,
        function(a, b)
            return a.distance < b.distance
        end
    )

    while #eggResults > MAX_RESULTS do
        table.remove(eggResults)
    end

    local lines = {}

    table.insert(
        lines,
        "=============================="
    )

    table.insert(
        lines,
        "EGG RECON v1"
    )

    table.insert(
        lines,
        "=============================="
    )

    table.insert(
        lines,
        "Found: " ..
        tostring(#eggResults)
    )

    table.insert(
        lines,
        ""
    )

    for index, result in ipairs(
        eggResults
    ) do

        local obj =
            result.instance

        table.insert(
            lines,
            string.format(
                "[%02d] %s <%s> %.1f studs",
                index,
                obj.Name,
                obj.ClassName,
                result.distance
            )
        )

        table.insert(
            lines,
            "     " ..
            obj:GetFullName()
        )

    end

    outputText.Text =
        table.concat(
            lines,
            "\n"
        )

    status.Text =
        "Found " ..
        tostring(#eggResults) ..
        " egg-related objects"

end

--------------------------------------------------
-- INSPECT OBJECT
--------------------------------------------------

local function inspectObject(instance)

    if not instance then
        return
    end

    local lines = {}

    table.insert(
        lines,
        "=========================================="
    )

    table.insert(
        lines,
        "EGG OBJECT INSPECTION"
    )

    table.insert(
        lines,
        "=========================================="
    )

    table.insert(
        lines,
        ""
    )

    --------------------------------------------------
    -- BASIC
    --------------------------------------------------

    table.insert(
        lines,
        "[BASIC]"
    )

    table.insert(
        lines,
        "Name      : " ..
        instance.Name
    )

    table.insert(
        lines,
        "Class     : " ..
        instance.ClassName
    )

    table.insert(
        lines,
        "Parent    : " ..
        (
            instance.Parent
            and instance.Parent:GetFullName()
            or "nil"
        )
    )

    table.insert(
        lines,
        "Full Path : " ..
        instance:GetFullName()
    )

    local position =
        getPosition(instance)

    if position then

        table.insert(
            lines,
            string.format(
                "Position  : %.2f, %.2f, %.2f",
                position.X,
                position.Y,
                position.Z
            )
        )

    end

    --------------------------------------------------
    -- ATTRIBUTES
    --------------------------------------------------

    local attributes =
        instance:GetAttributes()

    table.insert(
        lines,
        ""
    )

    table.insert(
        lines,
        "[ATTRIBUTES]"
    )

    if next(attributes) == nil then

        table.insert(
            lines,
            "  <none>"
        )

    else

        for name, value in pairs(
            attributes
        ) do

            table.insert(
                lines,
                "  " ..
                name ..
                " = " ..
                formatValue(value)
            )

        end

    end

    --------------------------------------------------
    -- DIRECT CHILDREN
    --------------------------------------------------

    table.insert(
        lines,
        ""
    )

    table.insert(
        lines,
        "[DIRECT CHILDREN]"
    )

    local children =
        instance:GetChildren()

    if #children == 0 then

        table.insert(
            lines,
            "  <none>"
        )

    else

        for _, child in ipairs(
            children
        ) do

            table.insert(
                lines,
                "  " ..
                child.Name ..
                " [" ..
                child.ClassName ..
                "]"
            )

        end

    end

    --------------------------------------------------
    -- VALUE OBJECTS
    --------------------------------------------------

    table.insert(
        lines,
        ""
    )

    table.insert(
        lines,
        "[VALUE OBJECTS]"
    )

    local foundValues = false

    for _, descendant in ipairs(
        instance:GetDescendants()
    ) do

        if descendant:IsA("ValueBase") then

            foundValues = true

            table.insert(
                lines,
                "  " ..
                descendant:GetFullName() ..
                " = " ..
                formatValue(
                    descendant.Value
                )
            )

        end

    end

    if not foundValues then

        table.insert(
            lines,
            "  <none>"
        )

    end

    --------------------------------------------------
    -- PROMPTS
    --------------------------------------------------

    table.insert(
        lines,
        ""
    )

    table.insert(
        lines,
        "[INTERACTION OBJECTS]"
    )

    local foundInteraction =
        false

    for _, descendant in ipairs(
        instance:GetDescendants()
    ) do

        if descendant:IsA(
            "ProximityPrompt"
        )
        or descendant:IsA(
            "ClickDetector"
        ) then

            foundInteraction = true

            table.insert(
                lines,
                "  " ..
                descendant:GetFullName()
            )

            if descendant:IsA(
                "ProximityPrompt"
            ) then

                table.insert(
                    lines,
                    "     ActionText = " ..
                    descendant.ActionText
                )

                table.insert(
                    lines,
                    "     ObjectText = " ..
                    descendant.ObjectText
                )

                table.insert(
                    lines,
                    "     HoldDuration = " ..
                    tostring(
                        descendant.HoldDuration
                    )
                )

            end

        end

    end

    if not foundInteraction then

        table.insert(
            lines,
            "  <none>"
        )

    end

    --------------------------------------------------
    -- HUMANOID
    --------------------------------------------------

    local humanoid =
        instance:FindFirstChildWhichIsA(
            "Humanoid",
            true
        )

    table.insert(
        lines,
        ""
    )

    table.insert(
        lines,
        "[HUMANOID]"
    )

    if humanoid then

        table.insert(
            lines,
            "  Path = " ..
            humanoid:GetFullName()
        )

        table.insert(
            lines,
            "  Health = " ..
            tostring(
                humanoid.Health
            )
        )

        table.insert(
            lines,
            "  MaxHealth = " ..
            tostring(
                humanoid.MaxHealth
            )
        )

    else

        table.insert(
            lines,
            "  <none>"
        )

    end

    --------------------------------------------------
    -- BASEPARTS
    --------------------------------------------------

    table.insert(
        lines,
        ""
    )

    table.insert(
        lines,
        "[BASEPARTS]"
    )

    local partCount = 0

    for _, descendant in ipairs(
        instance:GetDescendants()
    ) do

        if descendant:IsA("BasePart") then

            partCount += 1

            if partCount <= 40 then

                table.insert(
                    lines,
                    "  " ..
                    descendant:GetFullName()
                )

            end

        end

    end

    if partCount == 0 then

        table.insert(
            lines,
            "  <none>"
        )

    elseif partCount > 40 then

        table.insert(
            lines,
            "  ... +" ..
            tostring(
                partCount - 40
            ) ..
            " more"
        )

    end

    --------------------------------------------------
    -- REMOTE / BINDABLE OBJECTS
    --------------------------------------------------

    table.insert(
        lines,
        ""
    )

    table.insert(
        lines,
        "[EVENT / REMOTE OBJECTS]"
    )

    local foundRemote = false

    for _, descendant in ipairs(
        instance:GetDescendants()
    ) do

        if descendant:IsA(
            "RemoteEvent"
        )
        or descendant:IsA(
            "RemoteFunction"
        )
        or descendant:IsA(
            "BindableEvent"
        )
        or descendant:IsA(
            "BindableFunction"
        ) then

            foundRemote = true

            table.insert(
                lines,
                "  " ..
                descendant:GetFullName() ..
                " [" ..
                descendant.ClassName ..
                "]"
            )

        end

    end

    if not foundRemote then

        table.insert(
            lines,
            "  <none>"
        )

    end

    outputText.Text =
        table.concat(
            lines,
            "\n"
        )

    status.Text =
        "Inspecting: " ..
        instance.Name

end

--------------------------------------------------
-- SNAPSHOT
--------------------------------------------------

local snapshot = nil

local function captureSnapshot()

    if not eggResults[1] then

        status.Text =
            "Scan first."

        return

    end

    local object =
        eggResults[1].instance

    if not object.Parent then

        status.Text =
            "Egg no longer exists."

        return

    end

    snapshot = {
        path = object:GetFullName(),
        name = object.Name,
        class = object.ClassName,
        attributes = object:GetAttributes(),
        children = {},
        values = {},
    }

    for _, child in ipairs(
        object:GetChildren()
    ) do

        snapshot.children[
            child.Name
        ] = child.ClassName

    end

    for _, descendant in ipairs(
        object:GetDescendants()
    ) do

        if descendant:IsA(
            "ValueBase"
        ) then

            snapshot.values[
                descendant:GetFullName()
            ] =
                formatValue(
                    descendant.Value
                )

        end

    end

    local humanoid =
        object:FindFirstChildWhichIsA(
            "Humanoid",
            true
        )

    if humanoid then

        snapshot.health =
            humanoid.Health

        snapshot.maxHealth =
            humanoid.MaxHealth

    end

    status.Text =
        "Snapshot saved for #1"

end

--------------------------------------------------
-- COMPARE
--------------------------------------------------

local function compareSnapshot()

    if not snapshot then

        status.Text =
            "No snapshot exists."

        return

    end

    local lines = {}

    table.insert(
        lines,
        "=========================================="
    )

    table.insert(
        lines,
        "BEFORE / AFTER COMPARISON"
    )

    table.insert(
        lines,
        "=========================================="
    )

    local current =
        workspace:FindFirstChild(
            snapshot.name,
            true
        )

    if not current then

        table.insert(
            lines,
            ""
        )

        table.insert(
            lines,
            "OBJECT NO LONGER FOUND."
        )

        table.insert(
            lines,
            ""
        )

        table.insert(
            lines,
            "Possible disappearance/destruction."
        )

        outputText.Text =
            table.concat(
                lines,
                "\n"
            )

        status.Text =
            "Object disappeared"

        return
    end

    local changes = 0

    --------------------------------------------------
    -- ATTRIBUTES
    --------------------------------------------------

    local currentAttributes =
        current:GetAttributes()

    for name, oldValue in pairs(
        snapshot.attributes
    ) do

        local newValue =
            currentAttributes[name]

        if tostring(oldValue) ~=
           tostring(newValue) then

            changes += 1

            table.insert(
                lines,
                ""
            )

            table.insert(
                lines,
                "[ATTRIBUTE CHANGED]"
            )

            table.insert(
                lines,
                name ..
                " : " ..
                formatValue(oldValue) ..
                " -> " ..
                formatValue(newValue)
            )

        end

    end

    for name, newValue in pairs(
        currentAttributes
    ) do

        if snapshot.attributes[name] == nil then

            changes += 1

            table.insert(
                lines,
                ""
            )

            table.insert(
                lines,
                "[NEW ATTRIBUTE]"
            )

            table.insert(
                lines,
                name ..
                " = " ..
                formatValue(newValue)
            )

        end

    end

    --------------------------------------------------
    -- HUMANOID
    --------------------------------------------------

    local humanoid =
        current:FindFirstChildWhichIsA(
            "Humanoid",
            true
        )

    if humanoid and snapshot.health then

        if humanoid.Health ~=
           snapshot.health then

            changes += 1

            table.insert(
                lines,
                ""
            )

            table.insert(
                lines,
                "[HEALTH CHANGED]"
            )

            table.insert(
                lines,
                tostring(
                    snapshot.health
                ) ..
                " -> " ..
                tostring(
                    humanoid.Health
                )
            )

        end

    end

    --------------------------------------------------
    -- CHILDREN
    --------------------------------------------------

    local currentChildren = {}

    for _, child in ipairs(
        current:GetChildren()
    ) do

        currentChildren[
            child.Name
        ] = child.ClassName

    end

    for name, class in pairs(
        currentChildren
    ) do

        if snapshot.children[name] == nil then

            changes += 1

            table.insert(
                lines,
                ""
            )

            table.insert(
                lines,
                "[NEW CHILD]"
            )

            table.insert(
                lines,
                name ..
                " [" ..
                class ..
                "]"
            )

        end

    end

    for name, class in pairs(
        snapshot.children
    ) do

        if currentChildren[name] == nil then

            changes += 1

            table.insert(
                lines,
                ""
            )

            table.insert(
                lines,
                "[REMOVED CHILD]"
            )

            table.insert(
                lines,
                name ..
                " [" ..
                class ..
                "]"
            )

        end

    end

    --------------------------------------------------
    -- RESULT
    --------------------------------------------------

    table.insert(
        lines,
        ""
    )

    table.insert(
        lines,
        "=========================================="
    )

    table.insert(
        lines,
        "TOTAL CHANGES: " ..
        tostring(changes)
    )

    table.insert(
        lines,
        "=========================================="
    )

    if changes == 0 then

        table.insert(
            lines,
            ""
        )

        table.insert(
            lines,
            "No tracked changes."
        )

    end

    outputText.Text =
        table.concat(
            lines,
            "\n"
        )

    status.Text =
        "Comparison complete"

end

