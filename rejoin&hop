-- FIX: using MouseButton1Click on a TextButton child is the most reliable approach
local BubbleBtn = mkbtn(Bubble, {
    bg = Color3.fromRGB(0, 0, 0), text = "",
    sz = UDim2.new(1, 0, 1, 0), pos = UDim2.new(0, 0, 0, 0), z = 20,
})
BubbleBtn.BackgroundTransparency = 1

-- Manual drag (doesn't interfere with clicks since BubbleBtn captures them)
do
    local dragging = false
    local dragStart, startPos, hasMoved

    BubbleBtn.MouseButton1Down:Connect(function()
        dragging = true
        hasMoved = false
        local mouse = game:GetService("Players").LocalPlayer:GetMouse()
        dragStart = Vector2.new(mouse.X, mouse.Y)
        startPos = Bubble.Position
    end)

    game:GetService("RunService").Heartbeat:Connect(function()
        if not dragging then return end
        local mouse = game:GetService("Players").LocalPlayer:GetMouse()
        local cur = Vector2.new(mouse.X, mouse.Y)
        if dragStart then
            local d = cur - dragStart
            if math.abs(d.X) > 3 or math.abs(d.Y) > 3 then
                hasMoved = true
                Bubble.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y
                )
            end
        end
    end)

    BubbleBtn.MouseButton1Up:Connect(function()
        dragging = false
    end)
end

