local function setStatus(txt, col, state)
    StatusSubLbl.Text = txt
    StatusSubLbl.TextColor3 = col or C.textDim
    if state == "ok" then
        StatusDotMain.BackgroundColor3 = C.green
        BubbleDot.BackgroundColor3 = C.green
    elseif state == "warn" then
        StatusDotMain.BackgroundColor3 = C.orange
        BubbleDot.BackgroundColor3 = C.orange
    elseif state == "hop" then
        StatusDotMain.BackgroundColor3 = Color3.fromRGB(120, 80, 255)
        BubbleDot.BackgroundColor3 = Color3.fromRGB(120, 80, 255)
    elseif state == "error" then
        StatusDotMain.BackgroundColor3 = C.red
        BubbleDot.BackgroundColor3 = C.red
    end
    addLog(txt, col)
end

local function getRandomServer()
    local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local ok, raw = pcall(function() return game:HttpGet(url) end)
    if not ok or not raw or raw == "" then return nil end
    local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok2 or not data or not data.data or #data.data == 0 then return nil end
    local cur = tostring(game.JobId)
    local list = {}
    for _, s in ipairs(data.data) do
        if s.id and tostring(s.id) ~= cur then
            table.insert(list, tostring(s.id))
        end
    end
    if #list == 0 then return nil end
    return list[math.random(1, #list)]
end

local function joinOnce()
    local threshold = math.max(1, math.floor(tonumber(ThreshInput.Text) or 1))
    local count = #Players:GetPlayers()
    if count <= threshold then
        setStatus("Only " .. count .. " players. No need to hop.", C.green, "ok")
        return false
    end
    setStatus("Searching for a low-pop server...", C.orange, "warn")
    task.wait(0.5)
    local serverId = getRandomServer()
    if not serverId then
        setStatus("Can't fetch servers. Enable HTTP in executor.", C.red, "error")
        return false
    end
    setStatus("Teleporting...", Color3.fromRGB(120, 180, 255), "hop")
    task.wait(0.5)
    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, serverId, LocalPlayer)
    end)
    if not ok then
        setStatus("Error: " .. tostring(err):sub(1, 55), C.red, "error")
        return false
    end
    return true
end

