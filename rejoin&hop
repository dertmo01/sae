-- ==============================
-- Open / Close panel
-- FIX: closePanel uses task.delay so it never yields the calling thread
-- FIX: BubbleBtn toggles open/close — same button both opens and closes
-- ==============================

local panelOpen = false
local function openPanel()
    if panelOpen then return end
    panelOpen = true
    MainPanel.Size = UDim2.new(0, PANEL_W, 0, 0)
    MainPanel.Visible = true
    TweenService:Create(MainPanel, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, PANEL_W, 0, PANEL_H)
    }):Play()
end
local function closePanel()
    if not panelOpen then return end
    panelOpen = false
    TweenService:Create(MainPanel, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Size = UDim2.new(0, PANEL_W, 0, 0)
    }):Play()
    task.delay(0.2, function()
        MainPanel.Visible = false
        MainPanel.Size = UDim2.new(0, PANEL_W, 0, PANEL_H)
    end)
end
-- Panel drag via header (UserInputService - works on all executors)
do
    local UIS = game:GetService("UserInputService")
    local pdragging = false
    local pdragStart, pstartPos

    PanelHeader.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            -- Dont drag if clicking the header buttons
            local mx, my = input.Position.X, input.Position.Y
            local ph = PanelHeader.AbsolutePosition
            local pw = PanelHeader.AbsoluteSize
            pdragging = true
            pdragStart = Vector2.new(mx, my)
            pstartPos  = MainPanel.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if pdragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Position - Vector3.new(pdragStart.X, pdragStart.Y, 0)
            MainPanel.Position = UDim2.new(
                pstartPos.X.Scale, pstartPos.X.Offset + d.X,
                pstartPos.Y.Scale, pstartPos.Y.Offset + d.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            pdragging = false
        end
    end)
end

