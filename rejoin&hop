-- ==============================
-- Helpers
-- ==============================

local function corner(p, r)
    local c = Instance.new("UICorner", p)
    c.CornerRadius = UDim.new(0, r or 10)
    return c
end

local function mkstroke(p, col, thick)
    local s = Instance.new("UIStroke", p)
    s.Color = col or C.stroke
    s.Thickness = thick or 1.5
    return s
end

local function mklabel(parent, props)
    local l = Instance.new("TextLabel", parent)
    l.BackgroundTransparency = 1
    l.Font = props.font or Enum.Font.Gotham
    l.TextSize = props.size or 12
    l.TextColor3 = props.color or C.text
    l.Text = props.text or ""
    l.TextXAlignment = props.xalign or Enum.TextXAlignment.Left
    l.TextYAlignment = props.yalign or Enum.TextYAlignment.Center
    l.TextWrapped = props.wrap or false
    l.Size = props.sz or UDim2.new(1, 0, 0, 20)
    l.Position = props.pos or UDim2.new(0, 0, 0, 0)
    l.ZIndex = props.z or 1
    return l
end

local function mkframe(parent, props)
    local f = Instance.new("Frame", parent)
    f.BackgroundColor3 = props.bg or C.panel
    f.BorderSizePixel = 0
    f.Size = props.sz or UDim2.new(1, 0, 0, 40)
    f.Position = props.pos or UDim2.new(0, 0, 0, 0)
    f.BackgroundTransparency = props.trans or 0
    f.ZIndex = props.z or 1
    if props.clip then f.ClipsDescendants = true end
    if props.radius then corner(f, props.radius) end
    return f
end

local function mkbtn(parent, props)
    local b = Instance.new("TextButton", parent)
    b.BackgroundColor3 = props.bg or C.accent
    b.BorderSizePixel = 0
    b.Font = props.font or Enum.Font.GothamBold
    b.TextSize = props.size or 12
    b.TextColor3 = props.color or C.text
    b.Text = props.text or ""
    b.AutoButtonColor = false
    b.Size = props.sz or UDim2.new(0, 80, 0, 30)
    b.Position = props.pos or UDim2.new(0, 0, 0, 0)
    b.ZIndex = props.z or 1
    if props.radius then corner(b, props.radius) end
    return b
end

local function hoverBtn(b, normal, hov)
    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = hov}):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = normal}):Play()
    end)
end

