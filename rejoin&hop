local autoEnabled = false
local autoThread = nil

-- Live player count
task.spawn(function()
    while ScreenGui.Parent do
        local count = #Players:GetPlayers()
        NowLabel.Text = "● " .. count .. " player(s) in this server"
        task.wait(1)
    end
end)

local function getRandomServer()
    local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local ok, raw = pcall(function() return game:HttpGet(url) end)
    if not ok or not raw or raw == "" then return nil end

    local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok2 or not data or not data.data or #data.data == 0 then return nil end

    local currentId = tostring(game.JobId)
    local candidates = {}
    for _, s in ipairs(data.data) do
        if s.id and tostring(s.id) ~= currentId then
            table.insert(candidates, tostring(s.id))
        end
    end

    if #candidates == 0 then return nil end
    return candidates[math.random(1, #candidates)]
end

local function joinOnce()
    local threshold = math.max(1, math.floor(tonumber(MaxBox.Text) or 1))
    local currentCount = #Players:GetPlayers()

    if currentCount <= threshold then
        StatusLabel.Text = "✓ Only " .. currentCount .. " player(s). No need to hop."
        StatusLabel.TextColor3 = Color3.fromRGB(100, 220, 130)
        return false
    end

    StatusLabel.Text = "Searching for a low-pop server..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 210, 60)
    task.wait(0.5)

    local serverId = getRandomServer()
    if not serverId then
        StatusLabel.Text = "Couldn't fetch servers. Enable HTTP in executor."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return false
    end

    StatusLabel.Text = "Teleporting..."
    StatusLabel.TextColor3 = Color3.fromRGB(120, 180, 255)
    task.wait(0.5)

    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, serverId, LocalPlayer)
    end)

    if not ok then
        StatusLabel.Text = "Error: " .. tostring(err):sub(1, 55)
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return false
    end

    return true
end

-- Join button
JoinBtn.MouseButton1Click:Connect(function()
    JoinBtn.Active = false
    joinOnce()
    task.wait(2)
    JoinBtn.Active = true
end)

-- Auto Join button
AutoBtn.MouseButton1Click:Connect(function()
    autoEnabled = not autoEnabled
    if autoEnabled then
        AutoBtn.Text = "Auto: ON"
        AutoBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        autoThread = task.spawn(function()
            while autoEnabled and ScreenGui.Parent do
                local threshold = math.max(1, math.floor(tonumber(MaxBox.Text) or 1))
                local count = #Players:GetPlayers()
                if count <= threshold then
                    StatusLabel.Text = "✓ " .. count .. " player(s). Watching..."
                    StatusLabel.TextColor3 = Color3.fromRGB(100, 220, 130)
                    task.wait(3)
                else
                    joinOnce()
                    task.wait(5)
                end
            end
        end)
    else
        AutoBtn.Text = "Auto: OFF"
        AutoBtn.BackgroundColor3 = Color3.fromRGB(35, 115, 65)
        if autoThread then task.cancel(autoThread) autoThread = nil end
        StatusLabel.Text = "Auto Join stopped."
        StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
    end
end)

-- Rejoin button — teleports you back into the SAME server (refreshes connection, fixes lag)
-- Uses TeleportService:Teleport() which reconnects you to the same PlaceId + same JobId instance
RejoinBtn.MouseButton1Click:Connect(function()
    RejoinBtn.Active = false
    StatusLabel.Text = "Rejoining server to refresh..."
    StatusLabel.TextColor3 = Color3.fromRGB(180, 120, 255)
    task.wait(0.8)

    -- TeleportToPlaceInstance with the CURRENT game.JobId = reconnect to THIS exact server
    -- This is the standard executor rejoin pattern used in the wild
    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, game.JobId, LocalPlayer)
    end)

    if not ok then
        -- Fallback: plain Teleport drops you into any server of the same place (still refreshes)
        local ok2, err2 = pcall(function()
            TeleportService:Teleport(PlaceId, LocalPlayer)
        end)
        if not ok2 then
            StatusLabel.Text = "Rejoin error: " .. tostring(err2):sub(1, 50)
            StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            task.wait(2)
            RejoinBtn.Active = true
        end
    end
end)

