local dragging, dragStart, startAbs
local function beginDrag(input)
    if input.UserInputType \~= Enum.UserInputType.MouseButton1
        and input.UserInputType \~= Enum.UserInputType.Touch then
        return
    end
    dragging = true
    dragStart = input.Position
    startAbs = card.AbsolutePosition
    card.AnchorPoint = Vector2.new(0, 0)
    card.Position = UDim2.fromOffset(startAbs.X, startAbs.Y)
end
card.InputBegan:Connect(beginDrag)
title.InputBegan:Connect(beginDrag)
UserInputService.InputChanged:Connect(function(input)
    if not dragging or not dragStart then
        return
    end
    if input.UserInputType \~= Enum.UserInputType.MouseMovement
        and input.UserInputType \~= Enum.UserInputType.Touch then
        return
    end
    local delta = input.Position - dragStart
    local vp = Workspace.CurrentCamera.ViewportSize
    card.Position = UDim2.fromOffset(
        math.clamp(startAbs.X + delta.X, 0, vp.X - card.AbsoluteSize.X),
        math.clamp(startAbs.Y + delta.Y, 0, vp.Y - card.AbsoluteSize.Y)
    )
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then
        return
    end
    if input.KeyCode == Enum.KeyCode.RightShift then
        AUTO = not AUTO
        log("auto=" .. tostring(AUTO))
    elseif input.KeyCode == Enum.KeyCode.B then
        task.spawn(stealOnce, true)
    elseif input.KeyCode == Enum.KeyCode.H then
        task.spawn(function()
            if BUSY then
                return
            end
            BUSY = true
            local prev = AUTO_PLANT
            AUTO_PLANT = true
            plotPulse()
            AUTO_PLANT = prev
            BUSY = false
        end)
    elseif input.KeyCode == Enum.KeyCode.T then
        task.spawn(shopPulse)
    elseif input.KeyCode == Enum.KeyCode.N then
        AUTO_PLANT = not AUTO_PLANT
        log("auto-plant=" .. tostring(AUTO_PLANT))
    elseif input.KeyCode == Enum.KeyCode.P then
        OVERLAY = not OVERLAY
    end
end)

