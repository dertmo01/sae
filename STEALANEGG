local SKIP_UNTIL = {}

local function mutationBonus(rec)
    local blob = tostring(rec.BaseMutation or "")
    if type(rec.Mutations) == "table" then
        for _, m in pairs(rec.Mutations) do
            blob ..= "," .. tostring(m)
        end
    end
    local s = blob:lower()
    if s:find("rainbow", 1, true) then
        return 50000000
    end
    if s:find("gold", 1, true) then
        return 30000000
    end
    if s:find("silver", 1, true) then
        return 10000000
    end
    if s \~= "" then
        return 2000000
    end
    return 0
end

local function assetRarityOf(category)
    local cfg = AssetsDir.Directory and AssetsDir.Directory[category]
    if type(cfg) \~= "table" or type(cfg.Rarity) \~= "table" then
        return 0, "?", 0
    end
    return tonumber(cfg.Rarity.RarityNumber) or 0,
        tostring(cfg.Rarity._id or "?"),
        tonumber(cfg.EarningRate) or 0
end

local function refreshRecords()
    local snap
    pcall(function()
        snap = EggCmds.GetAreaEggSnapshot()
    end)
    if type(snap) \~= "table" then
        return {}
    end
    return snap.Records or snap
end

local function pickBest()
    local nowt = os.clock()
    local best
    for _, rec in pairs(refreshRecords()) do
        if type(rec) == "table"
            and rec.State == "Slot"
            and typeof(rec.BottomCFrame) == "CFrame"
        then
            local uid = tostring(rec.Uid or "")
            local area = tostring(rec.AreaId or "")
            local skipAt = SKIP_UNTIL[uid]
            if uid \~= ""
                and not uid:find(tostring(USER_ID), 1, true)
                and not (skipAt and skipAt > nowt)
            then
                local stand, standDist = safeStand(rec.BottomCFrame.Position, area)
                if stand then
                    local cat = tostring(rec.AssetCategory or rec.Name or "Egg")
                    local rarN, rarName, earn = assetRarityOf(cat)
                    local score = rarN * 1000000000
                        + mutationBonus(rec)
                        + earn
                        + (AREA_RANK[area] or 0)
                    if not best or score > best.score then
                        best = {
                            uid = uid,
                            area = area,
                            rarity = rarName,
                            pos = rec.BottomCFrame.Position,
                            stand = stand,
                            standDist = standDist,
                            score = score,
                            label = string.format(
                                "%s  %s%s  %s",
                                cat,
                                rarName,
                                rec.BaseMutation and rec.BaseMutation \~= "" and (" " .. rec.BaseMutation) or "",
                                area
                            ),
                        }
                    end
                end
            end
        end
    end
    return best
end

local function equipBestTrail()
    local data = saveData()
    local owned = data.TrailInventory or {}
    local catalog = TrailsDir.Directory or {}
    local bestId, bestMult
    for id, cfg in pairs(catalog) do
        if owned[id] and type(cfg) == "table" and type(cfg.SpeedMultiplier) == "number" then
            if not bestMult or cfg.SpeedMultiplier > bestMult then
                bestId, bestMult = id, cfg.SpeedMultiplier
            end
        end
    end
    if not bestId or data.EquippedTrail == bestId then
        return false
    end
    local remote = ReplicatedStorage.Network:FindFirstChild("Trails: RequestSelect")
    if not remote then
        return false
    end
    local ok, res = pcall(function()
        return remote:InvokeServer(bestId)
    end)
    log(string.format("trail wear %s x%s -> %s", bestId, tostring(bestMult), tostring(res)))
    return res == true
end

local function equipBestAssets()
    local remote = ReplicatedStorage.Network:FindFirstChild("Backpack: EquipBest")
    if not remote then
        return false
    end
    local ok, res = pcall(function()
        return remote:InvokeServer()
    end)
    if res == true then
        log("equip best pets")
    end
    return res == true
end

local function buyBestTrail()
    local data = saveData()
    local money = tonumber(data.Money) or 0
    local owned = data.TrailInventory or {}
    local catalog = TrailsDir.Directory or {}
    local bestId, bestMult, bestPrice
    for id, cfg in pairs(catalog) do
        if type(cfg) == "table"
            and type(cfg.Price) == "number"
            and type(cfg.SpeedMultiplier) == "number"
            and not owned[id]
            and cfg.Price <= money
        then
            if not bestMult or cfg.SpeedMultiplier > bestMult then
                bestId, bestMult, bestPrice = id, cfg.SpeedMultiplier, cfg.Price
            end
        end
    end
    if not bestId then
        equipBestTrail()
        return false
    end
    local remote = ReplicatedStorage.Network:FindFirstChild("Trails: RequestPurchase")
    if not remote then
        return false
    end
    local ok, res = pcall(function()
        return remote:InvokeServer(bestId)
    end)
    log(string.format("trail buy %s $%.0f -> %s", bestId, bestPrice, tostring(res)))
    equipBestTrail()
    return res == true
end

local function upgradeTreadmill()
    local level = tonumber(saveData().TreadmillUpgradeLevel) or 1
    local ordered
    pcall(function()
        ordered = TreadmillsDir.GetOrdered()
    end)
    if type(ordered) \~= "table" then
        return false
    end
    local nextCfg = ordered[level + 1]
    if type(nextCfg) \~= "table" then
        return false
    end
    local price = tonumber(nextCfg.Price) or math.huge
    local money = tonumber(saveData().Money) or 0
    if money < price then
        return false
    end
    local remote = ReplicatedStorage.Network:FindFirstChild("Treadmills: RequestUpgrade")
    if not remote then
        return false
    end
    local ok, res, err = pcall(function()
        return remote:InvokeServer(nextCfg._id)
    end)
    log(string.format("tread %s $%.0f -> %s %s", tostring(nextCfg._id), price, tostring(res), tostring(err)))
    return res == true
end

local PLACE_SLOTS = {
    Vector3.new(0, 1.15, 0),
    Vector3.new(3, 1.15, 0),
    Vector3.new(-3, 1.15, 0),
    Vector3.new(0, 1.15, 3),
    Vector3.new(0, 1.15, -3),
    Vector3.new(3, 1.15, 3),
    Vector3.new(-3, 1.15, 3),
    Vector3.new(3, 1.15, -3),
    Vector3.new(-3, 1.15, -3),
    Vector3.new(6, 1.15, 0),
    Vector3.new(-6, 1.15, 0),
    Vector3.new(0, 1.15, 6),
}

local function occupiedSlots()
    local used = {}
    local plot = plotFolder()
    for uid in pairs(saveData().EggInventory or {}) do
        local rec = eggRecord(uid)
        if rec and rec.Placement and typeof(rec.Placement.LocalCFrame) == "CFrame" and plot then
            local world = plot:GetPivot():ToWorldSpace(rec.Placement.LocalCFrame)
            table.insert(used, world.Position)
        end
    end
    return used
end

local function slotFree(worldPos, used)
    for _, p in ipairs(used) do
        if (p - worldPos).Magnitude < 2.2 then
            return false
        end
    end
    return true
end

local function pickBestUnplaced()
    local best
    for id, rec in pairs(saveData().EggInventory or {}) do
        if type(rec) == "table" and not isPlaced(id) then
            local cat = tostring(rec.AssetCategory or rec.Category or rec.Name or id)
            local rarN, rarName, earn = assetRarityOf(cat)
            local score = rarN * 1000000000 + mutationBonus(rec) + earn
            if not best or score > best.score then
                best = {
                    uid = id,
                    name = cat,
                    rarity = rarName,
                    score = score,
                }
            end
        end
    end
    return best
end

local function placeOne()
    local area = petArea()
    local plot = plotFolder()
    local remote = ReplicatedStorage.Network:FindFirstChild("Eggs: RequestPlaceEgg")
    if not area or not plot or not remote then
        return false
    end
    local used = occupiedSlots()
    local pick = pickBestUnplaced()
    if not pick then
        return false
    end
    local uid, name = pick.uid, pick.name
    local world
    for _, off in ipairs(PLACE_SLOTS) do
        local cand = area.Position + off
        if slotFree(cand, used) then
            world = CFrame.new(cand)
            break
        end
    end
    if not world then
        return false
    end
    hopTo(world.Position + Vector3.new(0, 2.1, 0), 14, 0.42)
    pcall(function()
        return EggCmds.RequestEquipTool(uid)
    end)
    task.wait(0.08)
    local localCf = plot:GetPivot():ToObjectSpace(world)
    local ok, res, err = pcall(function()
        return remote:InvokeServer({ Uid = uid, LocalCFrame = localCf })
    end)
    log(string.format("place %s %s -> %s %s", tostring(pick.rarity), tostring(name), tostring(res), tostring(err)))
    return res == true
end

local function hatchReady()
    local n = 0
    for uid, rec in pairs(saveData().EggInventory or {}) do
        if isPlaced(uid) then
            local ready = false
            pcall(function()
                ready = EggCmds.IsLocalEggReady(uid) == true
            end)
            if ready then
                local name = type(rec) == "table" and rec.AssetCategory or uid
                local ok, res, err = pcall(function()
                    return EggCmds.RequestHatchEgg(uid)
                end)
                pcall(function()
                    return EggCmds.RequestCompleteHatchEgg(uid)
                end)
                log(string.format("hatch %s -> %s %s", tostring(name), tostring(res), tostring(err)))
                if res == true then
                    n += 1
                end
                task.wait(0.08)
            end
        end
    end
    return n
end

local function farmTreadmill(sec)
    local stand = treadmillStand()
    hopTo(stand, 14, 0.15)
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    local t1 = os.clock()
    local before = tonumber(saveData().SpeedPower) or 0
    while os.clock() - t1 < (sec or 3) and GEN == _G.__EggStealGen do
        local part = hrp()
        if part then
            local wob = stand + Vector3.new(math.sin(os.clock() * 7) * 2.2, 0, math.cos(os.clock() * 7) * 2.2)
            part.CFrame = CFrame.new(wob)
            if humanoid then
                humanoid:Move(Vector3.new(1, 0, 0), true)
            end
        end
        task.wait()
    end
    local after = tonumber(saveData().SpeedPower) or 0
    if after > before then
        log(string.format("speed %d -> %d", before, after))
    end
end

