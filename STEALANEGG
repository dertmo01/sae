local function isCrystalTree(inst)
    if not inst or not inst:IsA("Model") and not inst:IsA("BasePart") then
        return false
    end
    local name = string.lower(inst.Name)
    if name:find("crystal", 1, true)
        or name:find("sakura", 1, true) and (name:find("tree", 1, true) or name:find("blossom", 1, true))
        or name:find("bloomtree", 1, true)
        or name:find("crystalcherry", 1, true)
        or name:find("cherrycrystal", 1, true)
    then
        return true
    end
    if inst:GetAttribute("IsCrystalTree") or inst:GetAttribute("GreatBloom") then
        return true
    end
    return false
end

local function findCrystalTrees()
    local trees = {}
    local function scan(root, depth)
        if depth > 6 then
            return
        end
        for _, child in ipairs(root:GetChildren()) do
            if isCrystalTree(child) then
                local pos
                if child:IsA("Model") then
                    pos = child:GetPivot().Position
                elseif child:IsA("BasePart") then
                    pos = child.Position
                end
                if pos then
                    table.insert(trees, { model = child, pos = pos })
                end
            end
            scan(child, depth + 1)
        end
    end
    local objects = Workspace:FindFirstChild("__OBJECTS")
    if objects then
        scan(objects, 0)
    end
    if #trees == 0 then
        scan(Workspace, 0)
    end
    return trees
end

local function equipBat()
    local char = LocalPlayer.Character
    if not char then
        return false
    end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return false
    end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local n = string.lower(tool.Name)
        if n:find("bat", 1, true) or n:find("baseball", 1, true) then
            return true
        end
    end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, t in ipairs(backpack:GetChildren()) do
            if t:IsA("Tool") then
                local n = string.lower(t.Name)
                if n:find("bat", 1, true) or n:find("baseball", 1, true) then
                    humanoid:EquipTool(t)
                    task.wait(0.15)
                    return true
                end
            end
        end
    end
    return false
end

local function swingBat()
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool and tool:FindFirstChild("Handle") then
        pcall(function()
            tool:Activate()
        end)
    end
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton1(Vector2.new())
    end)
end

local function farmSakuraCrystals(maxSec)
    maxSec = maxSec or 18
    local trees = findCrystalTrees()
    if #trees == 0 then
        return false
    end

    BUSY = true
    log(string.format("SAKURA farm %d trees", #trees))

    if not equipBat() then
        log("no bat equipped")
        BUSY = false
        return false
    end

    local origin = currentPos()
    table.sort(trees, function(a, b)
        return (a.pos - origin).Magnitude < (b.pos - origin).Magnitude
    end)

    local deadline = os.clock() + maxSec
    local hits = 0

    for _, entry in ipairs(trees) do
        if GEN \~= _G.__EggStealGen or os.clock() > deadline then
            break
        end
        if not entry.model or not entry.model.Parent then
            continue
        end

        local standPos = entry.pos + Vector3.new(0, 2.5, 0)
        hopTo(standPos, 18, 0.12)

        local swingUntil = os.clock() + 1.6
        while os.clock() < swingUntil and GEN == _G.__EggStealGen do
            local part = hrp()
            if part then
                part.CFrame = CFrame.new(part.Position, entry.pos)
            end
            swingBat()
            hits += 1
            task.wait(0.18)
        end
    end

    log(string.format("sakura swings=%d", hits))
    hopTo(homeCF().Position, 18, 0.08)
    BUSY = false
    return hits > 0
end

local function isGreatBloomActive()
    return #findCrystalTrees() > 0
end

