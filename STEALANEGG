local function stealOnce(force)
    if BUSY then
        return false
    end
    if not force and isNight() then
        return false
    end
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health < 80 then
        return false
    end
    local target = pickBest()
    if not target or not target.stand then
        return false
    end
    BUSY = true
    log(string.format("STEAL %s stand=%.0f", target.label, target.standDist or -1))

    local y = roadY()
    local z = roadZ()
    local entry = corridorEntry()
    if currentPos().X < entry.X - 20 then
        hopTo(entry, 16, 0.12)
    end
    hopTo(Vector3.new(target.stand.X, y, z), 16, 0.08)
    hopTo(target.stand, 12, 0.20)

    if anyGuardAt(currentPos(), 2) then
        log("abort inside guard")
        hopTo(Vector3.new(target.stand.X - 40, y, z), 16, 0.08)
        hopTo(homeCF().Position, 18, 0.08)
        BUSY = false
        return false
    end

    local ok, res, err = pcall(function()
        return EggCmds.RequestCarryAreaEgg(target.uid)
    end)
    log("carry " .. tostring(res) .. " " .. tostring(err))

    hopTo(Vector3.new(target.stand.X - 45, y, z), 18, 0.05)
    hopTo(homeCF().Position, 18, 0.08)
    if res == true then
        log("inv=" .. inventoryCount())
        plotPulse()
    else
        SKIP_UNTIL[target.uid] = os.clock() + 40
        log("skip " .. target.label .. " 40s")
    end
    BUSY = false
    return res == true
end

