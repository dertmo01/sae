-- Rarity order for display (Divine = best)
local RARITY_ORDER = {
    Divine = 10, Eternal = 9, Secret = 8, Cosmic = 7,
    Mythic = 6, Legendary = 5, Epic = 4, Rare = 3,
    Uncommon = 2, Common = 1
}

local RARITY_COLORS = {
    Divine    = Color3.fromRGB(255, 100, 255),
    Eternal   = Color3.fromRGB(255, 200, 80),
    Secret    = Color3.fromRGB(180, 0, 255),
    Cosmic    = Color3.fromRGB(80, 200, 255),
    Mythic    = Color3.fromRGB(255, 80, 80),
    Legendary = Color3.fromRGB(255, 170, 0),
    Epic      = Color3.fromRGB(160, 80, 255),
    Rare      = Color3.fromRGB(80, 120, 255),
    Uncommon  = Color3.fromRGB(100, 220, 100),
    Common    = Color3.fromRGB(180, 180, 180),
}

local RS = game:GetService("ReplicatedStorage")

