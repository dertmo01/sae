-- Server list fetch
local function fetchServers()
    local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local ok, raw = pcall(function() return game:HttpGet(url) end)
    if not ok or not raw or raw == "" then return nil end
    local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok2 or not data or not data.data then return nil end
    return data.data
end

local function refreshServerList()
    ServerListLabel.Text = "⏳ Loading servers..."
    ServerListLabel.TextColor3 = Color3.fromRGB(180, 180, 100)

    -- Clear old rows except the label and button
    for _, child in ipairs(Body3:GetChildren()) do
        if child:IsA("TextLabel") and child ~= ServerListLabel then
            child:Destroy()
        end
    end

    task.spawn(function()
        local servers = fetchServers()
        if not servers or #servers == 0 then
            ServerListLabel.Text = "❌ Failed to fetch. Enable HTTP requests."
            ServerListLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            return
        end

        local currentId = tostring(game.JobId)
        local count = 0
        local threshold = math.max(1, math.floor(tonumber(MaxBox.Text) or 1))

        ServerListLabel.Text = "🖥️ " .. #servers .. " server(s) found:"
        ServerListLabel.TextColor3 = Color3.fromRGB(80, 180, 255)

        for i, s in ipairs(servers) do
            if count >= 8 then break end
            local isCurrent = tostring(s.id) == currentId
            local playing   = tonumber(s.playing) or 0
            local maxP      = s.maxPlayers or "?"
            local tag       = isCurrent and " ◀ YOU" or ""
            -- Mark servers that are below threshold (good to hop to)
            local hopTag    = (not isCurrent and playing <= threshold) and " ✓hop" or ""
            local rowColor  = isCurrent and Color3.fromRGB(100, 220, 130)
                           or (playing <= threshold and Color3.fromRGB(120, 220, 255))
                           or Color3.fromRGB(180, 180, 200)
            local row = AddRow(
                Body3,
                string.format("  [%d]  %d/%s players%s%s", i, playing, tostring(maxP), tag, hopTag),
                rowColor,
                10 + i
            )
            count = count + 1
        end
    end)
end

RefreshBtn.MouseButton1Click:Connect(refreshServerList)

-- Hop logic
local function getRandomServer()
    local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local ok, raw = pcall(function() return game:HttpGet(url) end)
    if not ok or not raw or raw == "" then return nil end
    local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok2 or not data or not data.data or #data.data == 0 then return nil end
    local currentId = tostring(game.JobId)
    local candidates = {}
    for _, s in ipairs(data.data) do
        if s.id and tostring(s.id) ~= currentId then
            table.insert(candidates, tostring(s.id))
        end
    end
    if #candidates == 0 then return nil end
    return candidates[math.random(1, #candidates)]
end

local function joinOnce()
    local threshold = math.max(1, math.floor(tonumber(MaxBox.Text) or 1))
    local currentCount = #Players:GetPlayers()

    if currentCount <= threshold then
        ThisServerStatus.Text = "Status: ✓ Good server (" .. currentCount .. " players)"
        ThisServerStatus.TextColor3 = Color3.fromRGB(100, 220, 100)
        StatusLabel.Text = "✓ Server is fine. No hop needed."
        StatusLabel.TextColor3 = Color3.fromRGB(100, 220, 100)
        return false
    end

    StatusLabel.Text = "🔍 Searching for another server..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
    task.wait(0.5)

    local serverId = getRandomServer()
    if not serverId then
        StatusLabel.Text = "❌ Failed to get server list."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        NotifDot.Visible = true
        return false
    end

    StatusLabel.Text = "🚀 Teleporting..."
    StatusLabel.TextColor3 = Color3.fromRGB(120, 180, 255)
    task.wait(0.5)

    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, serverId, LocalPlayer)
    end)

    if not ok then
        StatusLabel.Text = "❌ " .. tostring(err):sub(1, 55)
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        NotifDot.Visible = true
        return false
    end

    return true
end

