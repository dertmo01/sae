-- Get live area eggs snapshot via real EggCmds remote
local function getAreaEggs()
    if not EggCmds then return nil end
    local ok, snap = pcall(function()
        return EggCmds.GetAreaEggSnapshot()
    end)
    if not ok or type(snap) ~= "table" then return nil end
    return snap.Records or snap
end

-- Get player's own egg inventory via Save module
local function getInventoryEggs()
    if not Save then return nil end
    local ok, data = pcall(Save.Get)
    if not ok or type(data) ~= "table" then return nil end
    return data.EggInventory, data
end

-- Get rarity name for an egg asset category
local function getRarityName(category)
    if not AssetsDir then return "?" end
    local cfg = AssetsDir.Directory and AssetsDir.Directory[category]
    if type(cfg) ~= "table" or type(cfg.Rarity) ~= "table" then return "?" end
    return tostring(cfg.Rarity._id or "?")
end

-- Format mutation tag (Rainbow/Gold/Silver or custom)
local function getMutationTag(rec)
    local blob = tostring(rec.BaseMutation or "")
    if type(rec.Mutations) == "table" then
        for _, m in pairs(rec.Mutations) do
            blob = blob .. "," .. tostring(m)
        end
    end
    local s = blob:lower()
    if s:find("rainbow") then return "🌈" end
    if s:find("gold")    then return "🌕" end
    if s:find("silver")  then return "🩶" end
    if blob ~= ""        then return "✨" end
    return ""
end

-- Biome areas the game has (from open source community data)
local AREA_RANK = {
    Forest=1, Lake=2, Desert=3, Jungle=4, Snow=5,
    Volcano=6, ["Abyss Ocean"]=7, Prehistoric=8,
    Cosmic=9, ["Cherry Blossom"]=10, Sakura=10
}

-- Main scanner: tries real APIs first, falls back to workspace scan
local function scanEggs()
    local results = {}

    -- ── Method 1: Real API snapshot (works in-game with executor)
    local records = getAreaEggs()
    if records then
        local seen = {}
        for _, rec in pairs(records) do
            if type(rec) == "table" and rec.State == "Slot" then
                local cat     = tostring(rec.AssetCategory or rec.Name or "Egg")
                local area    = tostring(rec.AreaId or "?")
                local rarity  = getRarityName(cat)
                local mutTag  = getMutationTag(rec)
                local key     = cat .. rarity .. area
                if not seen[key] then
                    seen[key] = true
                    table.insert(results, {
                        name    = cat,
                        rarity  = rarity,
                        area    = area,
                        mut     = mutTag,
                        score   = (RARITY_ORDER[rarity] or 0) * 10 + (AREA_RANK[area] or 0),
                        source  = "live"
                    })
                end
            end
        end
    end

    -- ── Method 2: Player inventory eggs
    local inv, savedata = getInventoryEggs()
    if inv then
        for uid, rec in pairs(inv) do
            if type(rec) == "table" then
                local cat    = tostring(rec.AssetCategory or rec.Category or rec.Name or uid)
                local rarity = getRarityName(cat)
                local mutTag = getMutationTag(rec)
                table.insert(results, {
                    name   = cat,
                    rarity = rarity,
                    area   = "inventory",
                    mut    = mutTag,
                    score  = (RARITY_ORDER[rarity] or 0) * 10 + 100,
                    source = "inv"
                })
            end
        end
    end

    -- ── Method 3: Workspace fallback (generic scan if APIs not available)
    if #results == 0 then
        local ws = game:GetService("Workspace")
        local objects = ws:FindFirstChild("__OBJECTS")
        local root = objects and objects:FindFirstChild("Areas") or ws
        local function scan(parent, depth)
            if depth > 5 then return end
            for _, obj in ipairs(parent:GetChildren()) do
                local n = obj.Name:lower()
                if n:find("egg") then
                    local area = obj.Parent and obj.Parent.Name or "?"
                    table.insert(results, {
                        name   = obj.Name,
                        rarity = "?",
                        area   = area,
                        mut    = "",
                        score  = 0,
                        source = "ws"
                    })
                end
                scan(obj, depth + 1)
            end
        end
        pcall(scan, root, 0)
    end

    -- Sort best first
    table.sort(results, function(a, b) return a.score > b.score end)
    return results, savedata
end

