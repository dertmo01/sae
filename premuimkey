-- ANIMATION FUNCTIONS
local isAnimating = false

local function triggerErrorAnimation()
    if isAnimating then return end
    isAnimating = true

    TweenService:Create(InputBox, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(60, 20, 25) }):Play()
    TweenService:Create(InputStroke, TweenInfo.new(0.15), { Color = Color3.fromRGB(240, 80, 80) }):Play()

    task.spawn(function()
        local mainOffsets = {7, -7, 5, -5, 3, -3, 0}
        local tweenInfo = TweenInfo.new(0.04, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        
        for _, xOffset in ipairs(mainOffsets) do
            local tween = TweenService:Create(MainFrame, tweenInfo, { Position = NORMAL_MAIN_POS + UDim2.new(0, xOffset, 0, 0) })
            tween:Play()
            tween.Completed:Wait()
        end
    end)

    task.spawn(function()
        local inputOffsets = {-6, 6, -4, 4, -2, 2, 0}
        local tweenInfo = TweenInfo.new(0.04, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        
        for _, yOffset in ipairs(inputOffsets) do
            local tween = TweenService:Create(InputBox, tweenInfo, { Position = NORMAL_INPUT_POS + UDim2.new(0, 0, 0, yOffset) })
            tween:Play()
            tween.Completed:Wait()
        end
    end)

    task.delay(0.4, function()
        TweenService:Create(InputBox, TweenInfo.new(0.3), { BackgroundColor3 = NORMAL_INPUT_BG }):Play()
        TweenService:Create(InputStroke, TweenInfo.new(0.3), { Color = NORMAL_INPUT_STROKE }):Play()
        task.wait(0.3)
        isAnimating = false
    end)
end

local function triggerSuccessUnlock()
    -- 1. Success Button Styling
    ContinueBtn.Text = "Unlocked!"
    TweenService:Create(ContinueBtn, TweenInfo.new(0.3), { BackgroundColor3 = Color3.fromRGB(45, 190, 100) }):Play()
    
    -- 2. Green Glow Effect sa buong UI Border at Input Box
    TweenService:Create(MainStroke, TweenInfo.new(0.3), { Color = Color3.fromRGB(72, 230, 138), Transparency = 0 }):Play()
    TweenService:Create(InputStroke, TweenInfo.new(0.3), { Color = Color3.fromRGB(72, 230, 138) }):Play()

    -- 3. Light Shine Sweep Animation across the Frame
    ShineOverlay.Position = UDim2.new(-0.3, 0, 0, 0)
    TweenService:Create(ShineOverlay, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { Position = UDim2.new(1.3, 0, 0, 0) }):Play()

    -- 4. Unblur Background smoothly
    TweenService:Create(Blur, TweenInfo.new(0.6, Enum.EasingStyle.Sine), { Size = 0 }):Play()

    task.wait(0.4)

    -- 5. Premium Scale Up + Fade Out Exit Effect
    local exitInfo = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    
    TweenService:Create(MainFrame, exitInfo, {
        Size = UDim2.new(0, 410, 0, 220),
        Position = UDim2.new(0.5, -205, 0.5, -110)
    }):Play()

    -- Fade Out Lahat ng Elements inside
    for _, desc in ipairs(MainFrame:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("TextBox") or desc:IsA("TextButton") then
            TweenService:Create(desc, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
        end
        if desc:IsA("Frame") or desc:IsA("TextBox") or desc:IsA("TextButton") then
            TweenService:Create(desc, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
        end
        if desc:IsA("UIStroke") then
            TweenService:Create(desc, TweenInfo.new(0.3), { Transparency = 1 }):Play()
        end
    end
    TweenService:Create(MainFrame, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()

    task.wait(0.4)
    Blur:Destroy()
    ScreenGui:Destroy()
    
    print("Key system successfully unlocked!")
end

-- Key System Events (Fade In Animation Only)
GetKeyBtn.MouseButton1Click:Connect(function()
    -- Lalabas lang yung visual text gamit ang transparency animation
    TweenService:Create(SuccessLabel, TweenInfo.new(0.2), { TextTransparency = 0 }):Play()
    
    task.delay(3, function()
        TweenService:Create(SuccessLabel, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
    end)
end)

ContinueBtn.MouseButton1Click:Connect(function()
    if isAnimating then return end
    local userText = InputBox.Text
    ErrorLabel.Text = ""
    
    if userText == "" then
        ErrorLabel.Text = "Enter your key."
        triggerErrorAnimation()
        
        task.delay(5, function()
            if ErrorLabel.Text == "Enter your key." then
                ErrorLabel.Text = ""
            end
        end)
        
    elseif userText == CORRECT_KEY then
        ErrorLabel.Text = ""
        triggerSuccessUnlock()
    else
        ErrorLabel.Text = "Invalid key."
        triggerErrorAnimation()
        
        task.delay(5, function()
            if ErrorLabel.Text == "Invalid key." then
                ErrorLabel.Text = ""
            end
        end)
    end
end)
